# Re:Submit은 .env 파일을 자동으로 읽지 않습니다.
# 이 파일을 .env로 복사한 뒤 현재 셸에 불러오세요.
#
#   test -e .env || cp .env.example .env  # 최초 1회만 생성하며 기존 .env는 덮어쓰지 않습니다.
#   set -a
#   source .env
#   set +a
#   ./gradlew run --console=plain
#
# RESUBMIT_REVIEW_PROVIDER에는 fixture, openai, gemini, anthropic 중 하나를 지정합니다.
# API를 호출하지 않으려면 fixture를 사용하세요. 이 경우 API 키와 모델 설정은 필요하지 않습니다.
RESUBMIT_REVIEW_PROVIDER=fixture

# Solution.java를 열 에디터 명령입니다. 공백이 포함된 명령은 따옴표로 감싸세요.
# RESUBMIT_EDITOR가 비어 있으면 EDITOR를 사용하고, 둘 다 없으면 파일 절대 경로만 안내합니다.
RESUBMIT_EDITOR="code --wait"
# EDITOR=vim
# 화면 전환 없이 순차 출력하려면 아래 값을 설정하세요.
# RESUBMIT_NO_TUI=1

# OpenAI를 사용할 때 위 값을 openai로 바꾸고 아래 두 값을 설정하세요.
OPENAI_API_KEY=
OPENAI_MODEL=

# Gemini를 사용할 때 위 값을 gemini로 바꾸고 아래 두 값을 설정하세요.
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude를 사용할 때 위 값을 anthropic으로 바꾸고 아래 두 값을 설정하세요.
# RESUBMIT_REVIEW_PROVIDER=claude도 같은 provider를 선택합니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
